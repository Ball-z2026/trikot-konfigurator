  "query": "\n-- Aktualisiere Spielername-Zonen: height = 9% (7,5cm), width = 45% (25cm)\nUPDATE product_zones \nSET height = 9, width = 45, widthCm = 25, heightCm = 7.5,\n    maxWidthCm = 25, maxHeightCm = 7.5\nWHERE purpose = 'playerName';\n\n-- Aktualisiere Vereinsname-Zonen: height = 9% (7,5cm), width = 45% (25cm)\nUPDATE product_zones \nSET height = 9, width = 45, widthCm = 25, heightCm = 7.5,\n    maxWidthCm = 25, maxHeightCm = 7.5\nWHERE purpose = 'clubName';\n\n-- Prüfe die aktualisierten Werte\nSELECT id, purpose, posX, posY, width, height, widthCm, heightCm, maxWidthCm, maxHeightCm \nFROM product_zones \nWHERE purpose IN ('playerName', 'clubName', 'playerNumber')\nORDER BY purpose, id\nLIMIT 20;\n",
