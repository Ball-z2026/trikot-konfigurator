# Beispiel-Konfiguration – echte Werte in eine .env-Datei eintragen (nicht committen!)

# App / Auth
VITE_APP_ID=
JWT_SECRET=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Datenbank
DATABASE_URL=

# Eingebaute Forge-APIs (Bildgenerierung + Storage)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# PhotoRoom (Freistellen / Hintergrund entfernen)
PHOTOROOM_API_KEY=

# --- Externe Bildgenerierung über MCP-Server (optional) ---
# Ist BALLZ_IMAGE_MCP_URL gesetzt, läuft die KI-Bildgenerierung über diesen
# MCP-Server (Streamable HTTP) statt über die eingebaute Forge-Image-API.
# Die vollständige Endpoint-URL enthält bereits den Zugriffs-Token im Pfad,
# z. B. https://ballz-image-mcp.<host>/mcp/ballz-<TOKEN>
BALLZ_IMAGE_MCP_URL=
# Optional: fester Tool-Name auf dem MCP-Server. Leer lassen, dann wird das
# passende Bild-Tool automatisch per tools/list ermittelt.
BALLZ_IMAGE_MCP_TOOL=
